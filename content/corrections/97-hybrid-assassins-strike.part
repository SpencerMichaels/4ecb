<?xml version='1.0' encoding='UTF-8'?>
<!--
  Assassin's Strike (Hybrid) upgrades (owner decision, 2026-10-21). Merged
  after the CBLoader parts by scripts/build-private-content.sh. Structure
  only; no official text.

  A hybrid executioner may take +1d10 Assassin's Strike damage instead of an
  encounter attack power at levels 7, 13, 17, 23 and 27. The community part
  (37-hybrid.part) had only some "Level L ... Upgrade k" records (the k-th
  upgrade taken at level L), wrote each one's total into the power's Effect
  text, and put Level 27 Upgrade 3's prerequisite in its Category; levels 13
  and 23 offered nothing after an earlier upgrade. Every level now offers
  the upgrade whatever came before: each record adds "+1d10" to the power's
  "<power ID>:extra damage" stat, which the power card prints as an
  additional effect, and the published Effect text stays as written. A
  record's prerequisite is "has a (k-1)-th upgrade from an earlier level and
  no earlier k-th one", so exactly one record is open at each level.

  The upgrades need the power (owner decision, 2026-10-21). A hybrid
  executioner takes Assassin's Strike (Hybrid) as a level-1 encounter
  attack power, it is not granted, so each upgrade's prerequisite starts
  with "Assassin's Strike (Hybrid) Power", and the five optional selects
  require ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE, so a character without the
  power is not offered the upgrade choices at all. (The class feature has
  the same name as the power, hence the type in the prerequisite and the
  ID in the requires.)
-->
<D20Rules game-system="D&amp;D4E">
  <RemoveNodes internal-id="ID_CDJ_CLASS_FEATURE_HYBRID_ASSASSINS_STRIKE"><rules /></RemoveNodes>
  <AppendNodes internal-id="ID_CDJ_CLASS_FEATURE_HYBRID_ASSASSINS_STRIKE">
    <rules>
      <select type="Class Feature" Category="ID_CDJ_CLASS_FEATURE_LV7_ASSASSINS_STRIKE_1" number="1" level="7" optional="true" requires="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE" />
      <select type="Class Feature" Category="ID_CDJ_CLASS_FEATURE_LV13_ASSASSINS_STRIKE_1|ID_4ECB_CLASS_FEATURE_LV13_ASSASSINS_STRIKE_2" number="1" level="13" optional="true" requires="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE" />
      <select type="Class Feature" Category="ID_CDJ_CLASS_FEATURE_LV17_ASSASSINS_STRIKE_1|ID_CDJ_CLASS_FEATURE_LV17_ASSASSINS_STRIKE_2|ID_4ECB_CLASS_FEATURE_LV17_ASSASSINS_STRIKE_3" number="1" level="17" optional="true" requires="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE" />
      <select type="Class Feature" Category="ID_CDJ_CLASS_FEATURE_LV23_ASSASSINS_STRIKE_1|ID_CDJ_CLASS_FEATURE_LV23_ASSASSINS_STRIKE_2|ID_4ECB_CLASS_FEATURE_LV23_ASSASSINS_STRIKE_3|ID_4ECB_CLASS_FEATURE_LV23_ASSASSINS_STRIKE_4" number="1" level="23" optional="true" requires="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE" />
      <select type="Class Feature" Category="ID_CDJ_CLASS_FEATURE_LV27_ASSASSINS_STRIKE_1|ID_CDJ_CLASS_FEATURE_LV27_ASSASSINS_STRIKE_2|ID_CDJ_CLASS_FEATURE_LV27_ASSASSINS_STRIKE_3|ID_4ECB_CLASS_FEATURE_LV27_ASSASSINS_STRIKE_4|ID_4ECB_CLASS_FEATURE_LV27_ASSASSINS_STRIKE_5" number="1" level="27" optional="true" requires="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE" />
    </rules>
  </AppendNodes>
  <RulesElement internal-id="ID_CDJ_CLASS_FEATURE_LV7_ASSASSINS_STRIKE_1" name="Level 7 Assassin's Strike Upgrade 1" type="Class Feature" source="Dragon Magazine 400">
    <Prereqs> Assassin's Strike (Hybrid) Power </Prereqs>
    <specific name="Short Description"> +1d10 Assassin's Strike damage </specific>
    <specific name="Level"> 7 </specific>
    <rules>
      <grant type="Internal" name="ID_INTERNAL_NO_LV7_ENCOUNTER_POWER" />
      <grant type="Internal" name="ID_INTERNAL_BLOCK_LV7_HYBRID_PSONICS" />
      <statadd name="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE:extra damage" value="+1d10" />
    </rules>
  </RulesElement>
  <RulesElement internal-id="ID_CDJ_CLASS_FEATURE_LV13_ASSASSINS_STRIKE_1" name="Level 13 Assassin's Strike Upgrade 1" type="Class Feature" source="Dragon Magazine 400">
    <Prereqs> Assassin's Strike (Hybrid) Power, !Level 7 Assassin's Strike Upgrade 1 </Prereqs>
    <specific name="Short Description"> +1d10 Assassin's Strike damage </specific>
    <specific name="Level"> 13 </specific>
    <rules>
      <grant type="Internal" name="ID_INTERNAL_NO_LV13_ENCOUNTER_POWER" />
      <grant type="Internal" name="ID_INTERNAL_BLOCK_LV13_HYBRID_PSONICS" />
      <statadd name="ID_CDJ_POWER_HYBRID_ASSASSINS_STRIKE:extra damage" value="+1d10" />
    </rules>
  </RulesElement>
  <RulesElement internal-id="ID_4ECB_CLASS_FEATURE_LV13_ASSASSINS_STRIKE_2" name="Level 13 Assassin's Strike Upgrade 2" type="Class Feature" source="Dragon Magazine 400">
    <Prereqs> Assassin's Strike (Hybrid) Power, Level 7 Assassin's Strike Upgrade 1 </Prereqs>
    <specific name="Short Description"> +1d10 Assassin's Strike damage </specific>
    <specific name="Level"> 13 </specific>
    <rules>
      <grant type="Internal" name="ID_INTERNAL_NO_LV13_ENCOUNTER_POWER" />
      <grant type="Internal" name="ID_INTERNAL_BLOCK_LV13_HYBRID_PSONICS" />
