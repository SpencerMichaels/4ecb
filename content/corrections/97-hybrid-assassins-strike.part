  </RulesElement>
  <RulesElement internal-id="ID_4ECB_CLASS_FEATURE_LV17_ASSASSINS_STRIKE_3" name="Level 17 Assassin's Strike Upgrade 3" type="Class Feature" source="Dragon Magazine 400">
    <Prereqs> Assassin's Strike (Hybrid) Power, Level 13 Assassin's Strike Upgrade 2 </Prereqs>
    <specific name="Short Description"> +1d10 Assassin's Strike damage </specific>
