    <specific name="_SupportsID"> ID_FMP_DEITY_22 </specific>
    You count as a worshiper of Lolth for meeting prerequisites.
  </RulesElement>
  <AppendNodes internal-id="ID_FMP_DEITY_140">
    <rules>
      <grant name="ID_INTERNAL_COUNTSASDEITY_LOLTH" type="CountsAsDeity" />
    </rules>
  </AppendNodes>

  <RulesElement name="Tiamat" type="CountsAsDeity" internal-id="ID_INTERNAL_COUNTSASDEITY_TIAMAT" source="Forgotten Realms Campaign Guide">
    <specific name="_SupportsID"> ID_FMP_DEITY_43 </specific>
    You count as a worshiper of Tiamat for meeting prerequisites.
  </RulesElement>
  <AppendNodes internal-id="ID_FMP_DEITY_141">
