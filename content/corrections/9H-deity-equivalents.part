    <specific name="_SupportsID"> ID_FMP_DEITY_20 </specific>
    You count as a worshiper of Gruumsh for meeting prerequisites.
  </RulesElement>
  <AppendNodes internal-id="ID_FMP_DEITY_139">
    <rules>
      <grant name="ID_INTERNAL_COUNTSASDEITY_GRUUMSH" type="CountsAsDeity" />
    </rules>
  </AppendNodes>

