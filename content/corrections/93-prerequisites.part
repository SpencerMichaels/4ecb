  <!-- HarperTraining. -->
  <RemoveNodes internal-id="ID_FMP_EPIC_DESTINY_210"><Prereqs /></RemoveNodes>
  <AppendNodes internal-id="ID_FMP_EPIC_DESTINY_210"><Prereqs>21st level; good or lawful good alignment; ((trained in Diplomacy and trained in Insight) or (trained in Diplomacy and trained in Nature) or (trained in Diplomacy and trained in Stealth) or (trained in Insight and trained in Nature) or (trained in Insight and trained in Stealth) or (trained in Nature and trained in Stealth)); membership in the Harpers (see the sidebar)</Prereqs></AppendNodes>
  <!-- TwoKnowledgeSkills. -->
  <RemoveNodes internal-id="ID_FMP_EPIC_DESTINY_289"><Prereqs /></RemoveNodes>
  <AppendNodes internal-id="ID_FMP_EPIC_DESTINY_289"><Prereqs>21st level, Intelligence 21 or Wisdom 21, ((trained in Arcana and trained in Dungeoneering) or (trained in Arcana and trained in History) or (trained in Arcana and trained in Nature) or (trained in Arcana and trained in Religion) or (trained in Dungeoneering and trained in History) or (trained in Dungeoneering and trained in Nature) or (trained in Dungeoneering and trained in Religion) or (trained in History and trained in Nature) or (trained in History and trained in Religion) or (trained in Nature and trained in Religion))</Prereqs></AppendNodes>
