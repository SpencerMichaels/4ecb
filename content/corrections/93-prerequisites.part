<?xml version='1.0' encoding='UTF-8'?>
<!--
  Machine-read prerequisite rewrites (D089): each record's `Prereqs` is
  replaced by a form the modern parser resolves, porting the exact-text
  aliases of the legacy prerequisite SpecialCase / CompanionSpecialCase /
  TwoKnowledgeSkills / HarperTraining branches
  (pnpm audit:legacy-special-cases). `print-prereqs`, which players see, is
  untouched, so only records that have one are rewritten. Generic legacy
  grammar (prefix and suffix tables, Nth-level, any X feat, paragon
  multiclassing, race plus class, proficiency forms) is code in
  packages/rules-engine/src/prerequisites.ts. Merged after the CBLoader parts
  by scripts/build-private-content.sh. Structure only; no official text.
-->
<D20Rules game-system="D&amp;D4E">
  <!-- SpecialCase: 21st-level wizard / bard. -->
  <RemoveNodes internal-id="ID_FMP_EPIC_DESTINY_13"><Prereqs /></RemoveNodes>
  <AppendNodes internal-id="ID_FMP_EPIC_DESTINY_13"><Prereqs>(21st level and wizard)</Prereqs></AppendNodes>
  <RemoveNodes internal-id="ID_FMP_EPIC_DESTINY_209"><Prereqs /></RemoveNodes>
  <AppendNodes internal-id="ID_FMP_EPIC_DESTINY_209"><Prereqs>(21st level and wizard); eladrin or elf</Prereqs></AppendNodes>
  <RemoveNodes internal-id="ID_FMP_EPIC_DESTINY_286"><Prereqs /></RemoveNodes>
