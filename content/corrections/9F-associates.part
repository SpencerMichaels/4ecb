  <RulesElement name="Primal Predator Ally: Grizzly Bear" type="Internal" source="4ecb corrections" internal-id="ID_TIV_NATURAL_ALLY-7"><rules><statadd name="FREEBEE:ID_FMP_ASSOCIATE_47" value="+1" /></rules></RulesElement>
