  <!-- Unleash Monolith and Summon Flame Zephyr (Heroes of the Elemental Chaos): the powers grant only the cards. -->
  <RulesElement name="Air Monolith" type="Internal" source="4ecb corrections" internal-id="ID_TIV_COMPANION_AIR_MONOLITH"><rules><statadd name="FREEBEE:ID_FMP_ASSOCIATE_75" value="+1" /></rules></RulesElement>
  <RulesElement name="Earth Monolith" type="Internal" source="4ecb corrections" internal-id="ID_TIV_COMPANION_EARTH_MONOLITH"><rules><statadd name="FREEBEE:ID_FMP_ASSOCIATE_76" value="+1" /></rules></RulesElement>
