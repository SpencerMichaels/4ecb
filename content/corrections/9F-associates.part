  <RulesElement name="Primal Guardian Ally: Venomous Scorpion" type="Internal" source="4ecb corrections" internal-id="ID_TIV_NATURAL_ALLY-4"><rules><statadd name="FREEBEE:ID_FMP_ASSOCIATE_44" value="+1" /></rules></RulesElement>
  <RulesElement name="Primal Guardian Ally: Blue Dragon Wyrmling" type="Internal" source="4ecb corrections" internal-id="ID_TIV_NATURAL_ALLY-5"><rules><statadd name="FREEBEE:ID_FMP_ASSOCIATE_45" value="+1" /></rules></RulesElement>
