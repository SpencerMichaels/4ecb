{
  "name": "4ecb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first modern D&D 4E character builder",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter @4ecb/web build",
    "content-tool": "tsx apps/content-tool/src/main.ts",
    "dev": "pnpm --filter @4ecb/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
