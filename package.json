{
  "name": "4ecb",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Offline-first modern D&D 4E character builder",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@4ecb/character-domain": "workspace:*",
    "@4ecb/content-pack": "workspace:*",
    "@4ecb/legacy-dnd4e": "workspace:*",
    "@4ecb/query-engine": "workspace:*",
    "@4ecb/rules-engine": "workspace:*",
    "@4ecb/sheet-model": "workspace:*"
  },
  "scripts": {
    "benchmark:query": "tsx scripts/benchmark-query.ts",
    "audit:rules": "tsx scripts/audit-rules.ts",
    "audit:native-workflow": "tsx scripts/audit-native-workflow.ts",
    "evaluate:character": "tsx scripts/evaluate-character.ts",
    "evaluate:matrix": "bash scripts/evaluate-character-matrix.sh",
    "regenerate:edited-dnd4e": "tsx scripts/regenerate-edited-dnd4e.ts",
    "build": "pnpm typecheck && pnpm --filter @4ecb/web build",
    "content-tool": "tsx apps/content-tool/src/main.ts",
    "dev": "pnpm --filter @4ecb/web dev",
    "check:print": "node scripts/check-print.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
